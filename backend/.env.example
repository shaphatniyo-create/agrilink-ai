DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agrilink?schema=public"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="30d"
PORT=4000
NODE_ENV=production

# Public URL of the frontend -- used to build email verification links and
# to redirect the browser back after Google Sign-In completes.
FRONTEND_URL="http://localhost:5173"
# Public URL of THIS backend -- used as the Google OAuth callback base.
BACKEND_URL="http://localhost:4000"

# SMTP (confirmation / approval emails). Without these, emails are logged to
# the server console instead of sent -- see backend/src/email/email.service.ts.
# Any standard SMTP provider works (Gmail SMTP with an App Password, SendGrid,
# Mailgun, Amazon SES, etc.) -- Gmail example:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=you@gmail.com
#   SMTP_PASS=<16-char App Password, NOT your normal Gmail password>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AgriLink AI <no-reply@agrilink.rw>"

# Google Sign-In. Create an OAuth 2.0 Client ID (type: Web application) in
# Google Cloud Console > APIs & Services > Credentials, with authorized
# redirect URI: {BACKEND_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payment providers (fill in when live credentials are issued)
MTN_MOMO_API_KEY=
MTN_MOMO_API_SECRET=
AIRTEL_MONEY_API_KEY=
BANK_CARD_MERCHANT_ID=
